# who this node's assistant is (Minerva's assistant/assistant.conf): her name in the texts ({assistant})
option('assistant-file', type: 'string', value: '/etc/minerva/assistant.conf',
       description: 'The node assistant file ([assistant] name)')
# the configuration layers' folders (Minerva's docs/packaging.md, "Configuration"; minerva-base installs the file)
option('layers-file', type: 'string', value: '/usr/lib/minerva/layers.conf',
       description: 'The file naming the configuration layer folders, lowest first')
# where the Minerva packages install their programs (minerva-config, minerva-perm...; Minerva's docs/packaging.md); a
# program's own env var (minerva-perm -> MINERVA_PERM_BIN) overrides its path
option('minerva-bin-dir', type: 'string', value: '/usr/lib/minerva/bin',
       description: 'The directory of the Minerva programs')
