# the root-owned callers file of the one rule (Minerva's docs/who-may-call.md; agentic-phosh's option of the same name)
option('callers-file', type: 'string', value: '/etc/phosh/callers.ini',
       description: 'Root-owned file naming the programs that may call each restricted method')
# who this node's assistant is (Minerva's assistant/assistant.conf): her conversation is listed first, and shows her contact
option('assistant-file', type: 'string', value: '/etc/minerva/assistant.conf',
       description: 'The node assistant file ([assistant] name)')
# the configuration layers' folders (Minerva's docs/packaging.md, "Configuration"; minerva-base installs the file)
option('layers-file', type: 'string', value: '/usr/lib/minerva/layers.conf',
       description: 'The file naming the configuration layer folders, lowest first')
# where the Minerva packages install their programs (minerva-config...; Minerva's docs/packaging.md); a program's own
# env var (minerva-config -> MINERVA_CONFIG_BIN) overrides its path. The provider registry asks minerva-config for the
# messaging channels (`channels --json`)
option('minerva-bin-dir', type: 'string', value: '/usr/lib/minerva/bin',
       description: 'The directory of the Minerva programs')
