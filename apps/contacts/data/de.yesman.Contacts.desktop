[Desktop Entry]
Type=Application
Name=Contacts
Comment=Keep the people you know in one list
Exec=neo-contacts %U
Icon=de.yesman.Contacts
Terminal=false
StartupNotify=false
DBusActivatable=true
Categories=Office;ContactManagement;GTK;
Keywords=Contacts;People;Address;Book;vCard;Friends;
# a .vcf file opened with the app is imported (after "Import contacts from vCard?")
MimeType=text/vcard;text/x-vcard;text/directory;
X-GNOME-UsesNotifications=true
X-Purism-FormFactor=Workstation;Mobile;
Actions=minerva-settings;

# Settings › Minerva › Memoria › Fiducia: the people's rules (trust, forgetting strangers), the app's own page
[Desktop Action minerva-settings]
Name=Minerva settings
Exec=gapplication action de.yesman.Contacts minerva-settings
