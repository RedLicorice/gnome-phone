[Desktop Entry]
Type=Application
Name=Camera
Name[de]=Kamera
Comment=Take photos and videos, scan barcodes
Comment[de]=Fotos und Videos aufnehmen, Barcodes scannen
Exec=neo-camera
Icon=de.yesman.Camera
Terminal=false
StartupNotify=false
DBusActivatable=true
Categories=AudioVideo;Video;Recorder;GTK;
Keywords=Camera;Photo;Video;Picture;Selfie;QR;Barcode;
X-Purism-FormFactor=Workstation;Mobile;
Actions=ScanKey;

[Desktop Action ScanKey]
Name=Import key (QR)
Name[de]=Schlüssel importieren (QR)
Exec=neo-camera --scan
