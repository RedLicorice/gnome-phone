# copy to .env (ignored by git); read by tools/deploy-extension.sh
# The login (host, user, key, operator) comes from Minerva's tools/phone and its .env; only the extension's own settings are here.
# PHONE_EXT_DIR=/usr/share/gnome-shell/extensions/gnome-phone@yesman.de
# PHONE_SESSION_SERVICE=gdm            # default: session_service of the active shell in tools/phone/shells.conf
# PHONE_TOOLS_DIR=../tools/phone       # where Minerva's tools/phone is
